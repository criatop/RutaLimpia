                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"REALIZADO\",\n  \"observacion\": \"Retiro completado\"\n}"
            },
            "url": {
              "raw": "{{gateway}}/rutas/paradas/1/resultado",
              "host": ["{{gateway}}"],
              "path": ["rutas", "paradas", "1", "resultado"]
            }
