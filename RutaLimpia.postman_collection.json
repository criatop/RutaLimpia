            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"ASIGNADA\",\n  \"camionId\": 1\n}"
            },
            "url": {
              "raw": "{{gateway}}/solicitudes/1/estado",
              "host": ["{{gateway}}"],
              "path": ["solicitudes", "1", "estado"]
            }
          }
        },
        {
          "name": "Cancelar",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{gateway}}/solicitudes/1",
              "host": ["{{gateway}}"],
              "path": ["solicitudes", "1"]
            }
          }
        }
      ]
