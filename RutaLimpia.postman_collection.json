              "raw": "{{gateway}}/solicitudes?usuarioId=1",
              "host": ["{{gateway}}"],
              "path": ["solicitudes"],
              "query": [
                {
                  "key": "usuarioId",
                  "value": "1"
                }
              ]
            }
          }
