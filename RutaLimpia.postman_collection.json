            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": 1,\n  \"direccion\": \"Av Principal 123\",\n  \"tipoResiduoId\": 1,\n  \"horarioPreferido\": \"09:00-12:00\"\n}"
