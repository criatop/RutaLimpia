    {
      "name": "Rutas",
      "item": [
        {
          "name": "Agregar Parada",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"solicitudId\": 1,\n  \"camionId\": 1,\n  \"direccion\": \"Av Principal 123\",\n  \"tipoResiduo\": \"Vidrio\",\n  \"horario\": \"09:00-12:00\",\n  \"fecha\": \"2024-01-15\"\n}"
            },
            "url": {
              "raw": "{{gateway}}/rutas/paradas",
              "host": ["{{gateway}}"],
              "path": ["rutas", "paradas"]
            }
          }
        },
        {
          "name": "Hoja de Ruta",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{gateway}}/rutas/camion/1?fecha=2024-01-15",
              "host": ["{{gateway}}"],
              "path": ["rutas", "camion", "1"],
              "query": [
                {
                  "key": "fecha",
                  "value": "2024-01-15"
                }
              ]
            }
          }
        },
        {
