{
  "info": {
    "name": "RutaLimpia",
    "description": "Colección de Postman para RutaLimpia",
    "schema": "https://schema.getpostman.com/json/collection/v2.0.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Perez\",\n  \"email\": \"juan@example.com\",\n  \"password\": \"password123\",\n  \"rol\": \"VECINO\",\n  \"camionId\": null\n}"
            },
            "url": {
              "raw": "{{gateway}}/auth/register",
              "host": ["{{gateway}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{gateway}}/auth/login",
              "host": ["{{gateway}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Validate Token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{gateway}}/auth/validate",
              "host": ["{{gateway}}"],
              "path": ["auth", "validate"]
            }
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Listar",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{gateway}}/usuarios",
              "host": ["{{gateway}}"],
              "path": ["usuarios"]
            }
          }
        },
        {
          "name": "Obtener por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{gateway}}/usuarios/1",
              "host": ["{{gateway}}"],
              "path": ["usuarios", "1"]
            }
          }
        },
        {
          "name": "Actualizar",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Perez\",\n  \"camionId\": null\n}"
            },
            "url": {
              "raw": "{{gateway}}/usuarios/1",
              "host": ["{{gateway}}"],
              "path": ["usuarios", "1"]
            }
          }
        },
        {
          "name": "Eliminar",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{gateway}}/usuarios/1",
              "host": ["{{gateway}}"],
              "path": ["usuarios", "1"]
            }
          }
        }
      ]
    },
